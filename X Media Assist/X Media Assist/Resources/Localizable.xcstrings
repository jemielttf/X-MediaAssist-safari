{
  "sourceLanguage": "en",
  "strings": {
    "app_tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save videos and animated GIFs from X."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xの動画とGIFアニメを保存します。"
          }
        }
      }
    },
    "extension_enable_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable the extension in Safari Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの設定で拡張機能を有効にしてください。"
          }
        }
      }
    },
    "extension_enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Safari extension is enabled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari拡張機能は有効です"
          }
        }
      }
    },
    "extension_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Safari extension is disabled. Enable it in Safari Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari拡張機能は無効です。Safariの設定で有効にしてください。"
          }
        }
      }
    },
    "how_to_use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to Use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い方"
          }
        }
      }
    },
    "step_enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable X Media Assist in Safari → Settings → Extensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの「設定 → 拡張機能」で有効にします。"
          }
        }
      }
    },
    "step_access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a post on X and allow access to the website."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xの投稿を開き、サイトへのアクセスを許可します。"
          }
        }
      }
    },
    "step_save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Save Video” to save to Downloads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「動画を保存」でダウンロードフォルダに保存します。"
          }
        }
      }
    },
    "open_preferences": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Safari Extension Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの拡張機能設定を開く"
          }
        }
      }
    },
    "preferences_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open Safari Settings. Choose Safari → Settings → Extensions from the menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Safariの設定を開けませんでした。Safariのメニューから「設定 → 拡張機能」を開いてください。"
          }
        }
      }
    },
    "gif_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF設定"
          }
        }
      }
    },
    "default_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本設定"
          }
        }
      }
    },
    "gif_loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading default settings…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本設定を読み込み中…"
          }
        }
      }
    },
    "gif_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for GIF downloads. Changes are saved automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のGIF保存に使います。変更は自動保存されます。"
          }
        }
      }
    },
    "gif_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load or save GIF settings. Close and reopen the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF設定を読み込み・保存できませんでした。アプリを開き直してください。"
          }
        }
      }
    },
    "quality": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画質"
          }
        }
      }
    },
    "quality_high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高"
          }
        }
      }
    },
    "quality_medium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medium"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中"
          }
        }
      }
    },
    "quality_low": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低"
          }
        }
      }
    },
    "max_frame_rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Max Frame Rate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大フレームレート"
          }
        }
      }
    },
    "output_size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output Size"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出力サイズ"
          }
        }
      }
    },
    "notes_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ"
          }
        }
      }
    },
    "note_formats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos are saved as MP4 and animated GIFs as GIF. If GIF conversion fails, the MP4 is saved instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画はMP4、GIFアニメはGIFで保存します。GIFに変換できなかった場合は、MP4で保存します。"
          }
        }
      }
    },
    "note_popup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a post has no save button, enter its URL using the extension button in Safari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿内にボタンがない場合は、Safariの拡張ボタンからURLを入力できます。"
          }
        }
      }
    },
    "note_menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the menu bar icon to manage Dock visibility and launching at login. The app keeps running when you close this window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーのアイコンから、Dock表示とログイン時起動を設定できます。ウインドウを閉じても常駐を続けます。"
          }
        }
      }
    },
    "no_warranty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AGPL-3.0-or-later / No warranty"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AGPL-3.0-or-later / 無保証"
          }
        }
      }
    },
    "open_licenses": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenses and Copyright Notices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンス・著作権表示"
          }
        }
      }
    },
    "menu_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open X Media Assist"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X Media Assistを開く"
          }
        }
      }
    },
    "menu_hide_dock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Dock Icon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockに表示しない"
          }
        }
      }
    },
    "menu_launch_at_login": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動する"
          }
        }
      }
    },
    "menu_login_pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login (Awaiting Approval)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に起動する（承認待ち）"
          }
        }
      }
    },
    "menu_login_settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Login Items Settings…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目のシステム設定を開く…"
          }
        }
      }
    },
    "menu_quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit X Media Assist"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X Media Assistを終了"
          }
        }
      }
    },
    "dock_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change Dock visibility."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dockの表示設定を変更できませんでした。"
          }
        }
      }
    },
    "login_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change the launch-at-login setting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時起動の設定を変更できませんでした。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
